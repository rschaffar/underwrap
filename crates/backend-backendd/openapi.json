            "type": "boolean"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "WrapperApprovalMode": {
        "oneOf": [
          {
            "type": "object",
            "description": "Deny every invocation through this permission.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "locked"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Allow every invocation through this permission.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "unlocked"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Allow invocations until `until_epoch`; deny afterwards. The expiry is\nchecked lazily on each request — no server-side sweeper.",
            "required": [
              "until_epoch",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "unlocked-until"
                ]
              },
              "until_epoch": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              }
            }
          }
        ],
        "description": "Runtime mode for one [`WrapperPermission`]."
      },
      "WrapperPermission": {
        "type": "object",
        "description": "One per-store wrapper permission.\n\nThe tuple `(client_instance, wrapper, resource_id)` is the unique\nkey; persistence layers MUST reject duplicates with the stable\nerror code `duplicate_permission`. `resource_id` is the stable\nbackend id, so renaming a resource preserves every permission\nthat references it.",
        "required": [
          "client_instance",
          "wrapper",
          "resource_id"
        ],
        "properties": {
          "client_instance": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/WrapperApprovalMode"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Operator-facing free-form note. Surfaced in the wrapper\npermissions UI tooltip."
          },
          "resource_id": {
            "type": "string"
          },
          "wrapper": {
            "type": "string"
          },
          "writable": {
            "type": "boolean",
            "description": "Whether the wrapper may write to this resource through the\nsecretsd channel. Applies to the `files` and `libsecret` slots;\n`env` has no wrapper-side write path. Defaults to `false`."
          }
        }
      }
    },
