            "type": "string"
          },
          "password_changed_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "username": {
            "type": "string"
          }
        }
      },
      "AdminUserListItem": {
        "type": "object",
        "description": "One user record as visible to the admin UI. Mirrors\n`crate::users::UserRecord` minus the password hash, which the API\nnever returns.",
        "required": [
          "id",
          "username",
          "created_at",
          "password_changed_at"
        ],
        "properties": {
