  "components": {
    "schemas": {
      "AdminOkResponse": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "AdminOkUserResponse": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "AdminPasswordChangeRequest": {
        "type": "object",
        "description": "Self-service password change for the currently authenticated user.\nRequires the current password as proof-of-possession of the\nsession. Distinct from `POST /v1/admin/users/{id}/password`, which\nis the admin reset path and doesn't require the target's old\npassword.",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "AdminPolicyGetRequest": {
        "type": "object",
        "required": [
          "store"
        ],
        "properties": {
          "store": {
            "type": "string"
          }
        }
      },
      "AdminPolicyGetResponse": {
        "type": "object",
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/PolicyDocument"
          }
        }
      },
      "AdminPolicyPutRequest": {
        "type": "object",
        "required": [
          "store",
          "document"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/PolicyDocument"
          },
          "store": {
            "type": "string"
          }
        }
      },
      "AdminUiOverviewResponse": {
        "type": "object",
        "required": [
          "stores"
        ],
        "properties": {
          "stores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUiOverviewStore"
            }
          }
        }
      },
      "AdminUiOverviewStore": {
        "type": "object",
        "required": [
          "store",
          "resource_count",
          "wrapper_counts",
          "writable_permission_count"
        ],
        "properties": {
          "resource_count": {
            "type": "integer",
            "minimum": 0
          },
          "store": {
            "type": "string"
          },
          "wrapper_counts": {
            "$ref": "#/components/schemas/AdminUiWrapperCounts"
          },
          "writable_permission_count": {
            "type": "integer",
            "description": "Number of wrapper permissions with `writable = true`. Surfaced\non the dashboard overview as a quick \"how many wrapper writes\nare open\" signal.",
            "minimum": 0
          }
        }
      },
      "AdminUiWrapperCounts": {
        "type": "object",
        "required": [
          "locked",
          "unlocked",
          "unlocked_until"
        ],
        "properties": {
          "locked": {
            "type": "integer",
            "minimum": 0
          },
          "unlocked": {
            "type": "integer",
            "minimum": 0
          },
          "unlocked_until": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AdminUserCreateRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "Plaintext on the wire (over TLS). Hashed server-side with\nArgon2id before any storage step. Never echoed back."
          },
