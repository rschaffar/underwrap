                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Backend could not persist the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "csrf_header": []
          }
        ]
      }
    },
    "/v1/admin/auth/whoami": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "axum_whoami",
        "responses": {
          "200": {
            "description": "Returns the current operator, or `authenticated: false` if no session is present. Never 401 — designed for the SPA's bootstrap-redirect dance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            }
          }
        }
      }
    },
