{
  "openapi": "3.1.0",
  "info": {
    "title": "underwrap admin API",
    "description": "Operator-facing JSON API exposed by `underwrap-backendd` under `/v1/admin/*`. Authentication is session-cookie based (`__Host-uw-session`); state-changing requests must also carry the synchronizer CSRF header `X-CSRF-Token`. The mTLS runtime API is not part of this contract.",
    "license": {
      "name": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/admin/auth/bootstrap": {
      "post": {
        "tags": [
          "bootstrap"
        ],
        "operationId": "axum_bootstrap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "First operator created; session issued in the same response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (e.g. password too short).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Bootstrap already completed; further attempts are refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Backend could not write the operator collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/auth/bootstrap/status": {
      "get": {
        "tags": [
          "bootstrap"
        ],
        "operationId": "axum_bootstrap_status",
        "responses": {
          "200": {
            "description": "True only when the operator collection is empty and the bootstrap-completed sentinel is unset.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "axum_login_route",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login succeeded; session cookie set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid username or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate-limited; too many login attempts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Backend could not read user collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "axum_logout",
        "responses": {
          "204": {
            "description": "Session destroyed and cookie cleared."
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "csrf_header": []
          }
        ]
      }
    },
